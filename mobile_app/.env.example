# ========================================================================
# MOBILE APP — LOCAL DEVELOPMENT CONFIGURATION
# ========================================================================
# Copy this file to .env and update values as needed.
# This file is loaded by flutter_dotenv at app startup.
#
# IMPORTANT: Use your machine's local IP address (not localhost)
# for the mobile device/emulator to reach the backend server.
# Find your IP: ipconfig (Windows) or ifconfig (Linux/macOS)

# Backend API base URL
API_BASE_URL=http://192.168.1.100:8000/api

# App Configuration
APP_NAME=ArogyaTrack
APP_VERSION=1.0.0
