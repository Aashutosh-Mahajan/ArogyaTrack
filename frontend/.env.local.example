# ========================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ========================================================================
# Copy this file to .env.local for local development
# Frontend runs on: http://localhost:3000
# Backend API runs on: http://localhost:8000

# API Configuration (Backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# App Configuration
NEXT_PUBLIC_APP_NAME="Health Surveillance System"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Map Configuration (Optional - for production)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Feature Flags
NEXT_PUBLIC_ENABLE_VIDEO_CALL=false
NEXT_PUBLIC_ENABLE_CONTACT_TRACING=false

# Map basemap tiles (optional). Default: OpenStreetMap, open data and no API key.
# Dark mode inverts the tiles in CSS unless NEXT_PUBLIC_MAP_TILE_URL_DARK is set.
# Other open, key-free tile servers you can switch to:
#   Humanitarian (HOT): https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png
#   OpenTopoMap:        https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
