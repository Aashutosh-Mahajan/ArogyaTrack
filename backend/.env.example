# ========================================================================
# LOCAL DEVELOPMENT CONFIGURATION
# ========================================================================
# Copy this file to .env and update values as needed
# For localhost development, these defaults should work out of the box

# Django Core
# NOTE: outside DEBUG mode, SECRET_KEY / JWT_SECRET / DATABASE_URL are all
# required and the app will refuse to start without them (no silent weak
# fallbacks) — see backend/config/settings.py.
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional, DEBUG-only: extra hosts/origins for testing the mobile app against
# this machine's LAN IP. Never hardcode these in settings.py.
# DEV_ALLOWED_HOSTS=192.168.1.5
# DEV_LAN_ORIGINS=http://192.168.1.5:8000

# CORS Configuration (Production Only - Auto-configured for localhost in DEBUG mode)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database (PostgreSQL / Neon)
# Option 1: Use DATABASE_URL (recommended for Neon)
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Option 2: Use individual settings (for local PostgreSQL)
DB_NAME=health_surveillance
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# JWT
JWT_SECRET=change-me

# Redis / Cache
# USE_REDIS_CACHE must be "true" outside DEBUG mode — the in-memory cache
# doesn't work correctly across multiple worker processes (breaks rate limiting).
USE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-user
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@health-surveillance.local

# create_admin management command (python manage.py create_admin)
# No hardcoded default credentials — both must be set explicitly.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=<leave unset to auto-generate a random password>
